{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidensiq.dev/schemas/business-context/v0.1/business-context.schema.json",
  "title": "Evidensiq Business Context",
  "description": "Evidensiq Business Context Specification v0.1 — portable business context artifact for evidence-backed reasoning.",
  "type": "object",
  "required": ["specVersion", "organizationId"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "URI reference to this JSON Schema."
    },
    "specVersion": {
      "type": "string",
      "const": "0.1",
      "description": "Evidensiq Business Context Specification version."
    },
    "organizationId": {
      "$ref": "#/$defs/Id",
      "description": "ID of the primary Organization entity in this document."
    },
    "entities": {
      "type": "array",
      "items": { "$ref": "#/$defs/Entity" },
      "description": "Business entities (Organization, Product, Metric, Goal, etc.)."
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Relation" },
      "description": "Entity-to-Entity relationships."
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/Source" },
      "description": "Evidence sources (origins of raw business information)."
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/Evidence" },
      "description": "Evidence artifacts derived from sources."
    },
    "assertions": {
      "type": "array",
      "items": { "$ref": "#/$defs/Assertion" },
      "description": "Structured claims supported by evidence."
    },
    "signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/Signal" },
      "description": "Observed patterns or changes warranting attention."
    },
    "inferences": {
      "type": "array",
      "items": { "$ref": "#/$defs/Inference" },
      "description": "Derived analytical conclusions."
    },
    "recommendations": {
      "type": "array",
      "items": { "$ref": "#/$defs/Recommendation" },
      "description": "Validated actionable proposals."
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/Conflict" },
      "description": "Indexes over incompatible assertions."
    },
    "metadata": {
      "$ref": "#/$defs/Metadata",
      "description": "Document-level metadata."
    }
  },
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque UTF-8 identifier. Unique within the document. Case-sensitive Unicode ordinal comparison."
    },
    "DateTime": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 date-time. Conformance fixtures normalize to UTC with Z suffix."
    },
    "ExtensionKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$",
      "description": "Namespaced extension key using reverse-domain-style segments (e.g. com.example.field)."
    },
    "Extensions": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/ExtensionKey" },
      "additionalProperties": true,
      "description": "Controlled extension namespace. Unknown extensions MUST be preserved at L3 and ignored for normative core processing."
    },
    "ExternalIds": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/ExtensionKey" },
      "additionalProperties": { "type": "string" },
      "description": "Namespaced external identifiers. MUST NOT participate in internal reference resolution."
    },
    "ProvenanceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["originScope", "acquisitionMethod", "trustAssessment"],
      "properties": {
        "originScope": {
          "type": "string",
          "enum": ["internal", "external"],
          "description": "Whether the origin is internal or external to the organization."
        },
        "acquisitionMethod": {
          "type": "string",
          "enum": ["user-provided", "system-generated", "imported", "unknown"],
          "description": "How the content was acquired."
        },
        "trustAssessment": {
          "type": "string",
          "enum": ["trusted", "untrusted", "unknown"],
          "default": "unknown",
          "description": "Trust assessment. Does NOT grant authorization."
        }
      },
      "description": "Orthogonal provenance dimensions. trustAssessment ≠ authorization."
    },
    "ConfidenceDimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidenceStrength": {
          "type": "string",
          "enum": ["none", "weak", "moderate", "strong"]
        },
        "sourceReliability": {
          "type": "string",
          "enum": ["low", "moderate", "high", "unknown"]
        },
        "inferenceConfidence": {
          "type": "string",
          "enum": ["low", "moderate", "high"]
        }
      },
      "description": "Multi-dimensional confidence. evidenceFreshness is L4 policy-derived, not persisted normatively."
    },
    "ValidationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyId", "evaluatedAt", "result"],
      "properties": {
        "policyId": {
          "type": "string",
          "minLength": 1,
          "description": "Identifier of the validation policy applied."
        },
        "evaluatedAt": { "$ref": "#/$defs/DateTime" },
        "result": {
          "type": "string",
          "enum": ["valid", "invalid"]
        }
      },
      "description": "Validation policy evaluation metadata. Required when Assertion classification is validated."
    },
    "AssessmentMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluatedAt", "policyId", "results"],
      "properties": {
        "evaluatedAt": { "$ref": "#/$defs/DateTime" },
        "policyId": {
          "type": "string",
          "minLength": 1
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["check", "outcome"],
            "properties": {
              "check": { "type": "string" },
              "outcome": {
                "type": "string",
                "enum": ["pass", "fail", "warning"]
              }
            }
          }
        }
      },
      "description": "Recommendation assessment metadata. Persisted when status != candidate."
    },
    "Entity": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": {
          "type": "string",
          "description": "Entity primitive type (Organization, Product, Service, CustomerSegment, Channel, Process, Metric, Goal, Constraint, Competitor, etc.)."
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "validFrom": { "$ref": "#/$defs/DateTime" },
        "validUntil": { "$ref": "#/$defs/DateTime" },
        "observedAt": { "$ref": "#/$defs/DateTime" },
        "evidenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" }
        },
        "externalIds": { "$ref": "#/$defs/ExternalIds" },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "Entity-specific business attributes. Not schema extensions."
        },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "CoreRelationType": {
      "type": "string",
      "enum": [
        "targets",
        "acquiredVia",
        "produces",
        "measures",
        "constrains",
        "competesWith",
        "partOf"
      ],
      "description": "Approved v0.1 core relation vocabulary (Entity → Entity only)."
    },
    "Relation": {
      "type": "object",
      "required": ["id", "from", "to", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "from": { "$ref": "#/$defs/Id" },
        "to": { "$ref": "#/$defs/Id" },
        "type": {
          "oneOf": [
            { "$ref": "#/$defs/CoreRelationType" },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$",
              "not": { "$ref": "#/$defs/CoreRelationType" }
            }
          ],
          "description": "Core relation type or namespaced extension type."
        },
        "validFrom": { "$ref": "#/$defs/DateTime" },
        "validUntil": { "$ref": "#/$defs/DateTime" },
        "evidenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" }
        },
        "externalIds": { "$ref": "#/$defs/ExternalIds" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "Source": {
      "type": "object",
      "required": ["id", "type", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "Source" },
        "name": { "type": "string" },
        "reference": {
          "type": "string",
          "description": "URI or path reference to the source origin."
        },
        "provenance": { "$ref": "#/$defs/ProvenanceMetadata" },
        "externalIds": { "$ref": "#/$defs/ExternalIds" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "Evidence": {
      "type": "object",
      "required": ["id", "type", "sourceId"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "Evidence" },
        "sourceId": { "$ref": "#/$defs/Id" },
        "contentRef": {
          "type": "string",
          "description": "Reference to evidence content (file path, URI, or inline ref)."
        },
        "observedAt": { "$ref": "#/$defs/DateTime" },
        "provenance": {
          "$ref": "#/$defs/ProvenanceMetadata",
          "description": "Optional provenance override. May inherit Source semantics."
        },
        "description": { "type": "string" },
        "externalIds": { "$ref": "#/$defs/ExternalIds" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "Assertion": {
      "type": "object",
      "required": [
        "id",
        "type",
        "subject",
        "predicate",
        "value",
        "evidenceIds",
        "observedAt",
        "classification"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "Assertion" },
        "subject": {
          "$ref": "#/$defs/Id",
          "description": "Entity ID this assertion is about."
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "description": "Property or attribute being asserted."
        },
        "value": {
          "description": "Asserted value."
        },
        "evidenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "minItems": 1,
          "description": "Evidence supporting this assertion."
        },
        "observedAt": {
          "$ref": "#/$defs/DateTime",
          "description": "Record time — when assertion entered or was observed."
        },
        "classification": {
          "type": "string",
          "enum": ["asserted", "validated", "superseded", "retracted"]
        },
        "validFrom": { "$ref": "#/$defs/DateTime" },
        "validUntil": { "$ref": "#/$defs/DateTime" },
        "provenance": {
          "$ref": "#/$defs/ProvenanceMetadata",
          "description": "Optional provenance override."
        },
        "confidence": { "$ref": "#/$defs/ConfidenceDimensions" },
        "validation": { "$ref": "#/$defs/ValidationMetadata" },
        "supersededBy": {
          "$ref": "#/$defs/Id",
          "description": "Replacement Assertion ID. Required when classification is superseded."
        },
        "externalIds": { "$ref": "#/$defs/ExternalIds" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "classification": { "const": "validated" } },
            "required": ["classification"]
          },
          "then": { "required": ["validation"] }
        },
        {
          "if": {
            "properties": { "classification": { "const": "superseded" } },
            "required": ["classification"]
          },
          "then": { "required": ["supersededBy"] }
        }
      ]
    },
    "Signal": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "Signal" },
        "description": { "type": "string" },
        "evidenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" }
        },
        "observedAt": { "$ref": "#/$defs/DateTime" },
        "status": {
          "type": "string",
          "enum": ["active", "resolved", "superseded"]
        },
        "confidence": { "$ref": "#/$defs/ConfidenceDimensions" },
        "externalIds": { "$ref": "#/$defs/ExternalIds" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "Inference": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "Inference" },
        "description": { "type": "string" },
        "inferenceKind": {
          "type": "string",
          "enum": ["analytical", "opportunity", "risk"],
          "default": "analytical",
          "description": "Kind of inference. Opportunity and Risk are expressed via inferenceKind, not separate collections."
        },
        "basedOn": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "description": "IDs of signals, validated assertions, or other inferences."
        },
        "confidence": { "$ref": "#/$defs/ConfidenceDimensions" },
        "externalIds": { "$ref": "#/$defs/ExternalIds" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "Recommendation": {
      "type": "object",
      "required": ["id", "type", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "type": { "const": "Recommendation" },
        "description": { "type": "string" },
        "rationale": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "candidate",
            "supported",
            "insufficient-evidence",
            "conflicted",
            "stale",
            "rejected"
          ],
          "description": "Derived, reproducible assessment status. NOT workflow state."
        },
        "evidenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" }
        },
        "inferenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" }
        },
        "constraintIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" }
        },
        "confidence": { "$ref": "#/$defs/ConfidenceDimensions" },
        "assessment": { "$ref": "#/$defs/AssessmentMetadata" },
        "externalIds": { "$ref": "#/$defs/ExternalIds" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "not": { "const": "candidate" } }
            },
            "required": ["status"]
          },
          "then": { "required": ["assessment"] }
        }
      ]
    },
    "Conflict": {
      "type": "object",
      "required": ["id", "assertionIds", "conflictKind", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "assertionIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "minItems": 2,
          "description": "Assertions involved in this conflict."
        },
        "conflictKind": {
          "type": "string",
          "enum": ["contradiction", "uncertainty"]
        },
        "status": {
          "type": "string",
          "enum": ["unresolved", "acknowledged", "resolved"]
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": { "type": "string" },
            "resolvedAt": { "$ref": "#/$defs/DateTime" },
            "note": { "type": "string" },
            "preferredAssertionId": { "$ref": "#/$defs/Id" }
          }
        },
        "externalIds": { "$ref": "#/$defs/ExternalIds" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdAt": { "$ref": "#/$defs/DateTime" },
        "updatedAt": { "$ref": "#/$defs/DateTime" },
        "generator": { "type": "string" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      }
    },
    "BusinessContextProjectionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective": {
          "type": "string",
          "description": "Reasoning or decision objective guiding projection."
        },
        "domains": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Business domains to include."
        },
        "entityIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/Id" },
          "description": "Specific entity IDs to include."
        },
        "relationTraversal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxDepth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          }
        },
        "asOf": {
          "$ref": "#/$defs/DateTime",
          "description": "Temporal point for valid-time filtering."
        },
        "includeConflicts": {
          "type": "boolean",
          "description": "Whether to include unresolved conflicts."
        },
        "evidencePolicy": {
          "type": "string",
          "description": "Policy identifier for evidence inclusion."
        },
        "sizeLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxItems": { "type": "integer", "minimum": 1 },
            "maxCharacters": { "type": "integer", "minimum": 1 },
            "maxBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "ordering": {
          "type": "string",
          "description": "Deterministic ordering policy identifier."
        },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "description": "Provider-neutral projection request contract. NOT a root persisted property."
    },
    "BusinessContextProjectionResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectedAt": { "$ref": "#/$defs/DateTime" },
        "asOf": { "$ref": "#/$defs/DateTime" },
        "entities": {
          "type": "array",
          "items": { "$ref": "#/$defs/Entity" }
        },
        "relations": {
          "type": "array",
          "items": { "$ref": "#/$defs/Relation" }
        },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/$defs/Assertion" }
        },
        "signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/Signal" }
        },
        "inferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/Inference" }
        },
        "recommendations": {
          "type": "array",
          "items": { "$ref": "#/$defs/Recommendation" }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/Conflict" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/Evidence" }
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/Source" },
          "description": "Sources referenced by included Evidence, in original document.sources order. Omitted when empty."
        },
        "truncated": {
          "type": "boolean",
          "description": "Whether projection was truncated due to size limits."
        },
        "truncationReason": {
          "type": "string",
          "description": "Reason for truncation when truncated is true."
        },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "description": "Provider-neutral projection result contract. NOT a root persisted property."
    }
  }
}
