{
  "name": "@evidensiq/core",
  "version": "0.0.0",
  "description": "Evidensiq portable Business Context TypeScript model and foundation",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davideagosti-dev/evidensiq.git"
  },
  "bugs": {
    "url": "https://github.com/davideagosti-dev/evidensiq/issues"
  },
  "homepage": "https://github.com/davideagosti-dev/evidensiq#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check --linter-enabled=true --formatter-enabled=false --assist-enabled=false src test package.json tsconfig.json tsconfig.build.json vitest.config.ts biome.json",
    "format:check": "biome format src test package.json tsconfig.json tsconfig.build.json vitest.config.ts biome.json",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.19.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
