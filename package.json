{
  "name": "@evidensiq/core",
  "version": "0.1.0",
  "description": "Evidensiq TypeScript reference implementation for portable Business Context — model, validation, semantics, and conformance",
  "keywords": [
    "evidensiq",
    "business-context",
    "evidence",
    "provenance",
    "conformance",
    "typescript"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "specification/business-context.schema.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davideagosti-dev/evidensiq.git"
  },
  "bugs": {
    "url": "https://github.com/davideagosti-dev/evidensiq/issues"
  },
  "homepage": "https://github.com/davideagosti-dev/evidensiq#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "biome check --linter-enabled=true --formatter-enabled=false --assist-enabled=false src test examples package.json tsconfig.json tsconfig.build.json vitest.config.ts biome.json",
    "format:check": "biome format src test examples package.json tsconfig.json tsconfig.build.json vitest.config.ts biome.json",
    "pack:check": "npm pack --dry-run",
    "demo:northstar": "tsx examples/northstar-evaluation.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  }
}
